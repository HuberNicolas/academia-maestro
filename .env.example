# Copy to .env and fill in the key of the provider you use.

# --provider chatpdf (default): https://www.chatpdf.com/docs/api/backend
CHATPDF_KEY=

# --provider claude: https://platform.claude.com (or run `ant auth login` instead)
ANTHROPIC_API_KEY=

# --provider ollama: no key needed; optional defaults
# OLLAMA_MODEL=qwen3
# OLLAMA_HOST=http://localhost:11434
